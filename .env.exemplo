# Copie para .env e coloque seu usuario TikTok SEM @
TIKTOK_USERNAME=
PORT=3000

# true: nova batalha 10s depois da vitória; false: aguarda reinício manual
AUTO_RESTART=true

# Opcional: chave gratuita do Euler Stream, se aparecerem erros de limite na conexão TikTok
SIGN_API_KEY=

# Opcional: Groq varia as frases de torcida; sem chave, usa frases locais.
# A voz em português é a do navegador, não o TTS do Groq. Nunca colocar a chave no frontend.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Piper: opcional, requer Python/modelo instalados (Dockerfile incluído).
PIPER_ENABLED=false
PIPER_PYTHON=python3
PIPER_MODEL=/opt/piper/voices/pt_BR-faber-medium.onnx
# true (padrão): também gera voz para comentários amostrados; false: só presentes.
PIPER_COMMENTS=true
